---
import AdBanner from "../components/AdBanner.astro";
import framerBanner from "../assets/framer_ad.png";

export type Faq = {
  question: string;
  answer: string;
};

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  markdownPath?: string;
  faqs?: Faq[];
}

const { title, description, canonicalPath = '/', markdownPath, faqs = [] } = Astro.props;
const origin = 'https://generateurdecouleur.com';
const normalizedPath = canonicalPath.replace(/\/+$/, '') || '/';
const canonicalUrl = `${origin}${normalizedPath === '/' ? '' : normalizedPath}`;
const faqJsonLd =
  faqs.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      })
    : null;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {markdownPath && (
      <link rel="alternate" type="text/markdown" href={`${origin}${markdownPath}`} />
    )}
    <link rel="describedby" href={`${origin}/llms.txt`} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://generateurdecouleur.com/og-banner.jpg"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content="https://generateurdecouleur.com/og-banner.jpg"
    />

    {faqJsonLd && (
      <script is:inline type="application/ld+json" set:html={faqJsonLd} />
    )}

    <!-- Analytics -->
    <script
      defer
      src="https://api.pirsch.io/pa.js"
      id="pianjs"
      data-code="5C3k55SkoTTy4LonZYJmHMwugsasSt8Z"></script>
  </head>
  <body id="top" class="bg-white text-slate-900">
    <slot />
    <AdBanner
      description="Publiez votre site web en quelques minutes avec Framer."
      link="/go/framer"
      imageUrl={framerBanner}
    />
  </body>
</html>
