---
import AdBanner from "../components/AdBanner.astro";
import framerBanner from "../assets/framer_ad.png";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;
const origin = 'https://generateurdecouleur.com';
const canonicalUrl =
  canonicalPath === '/'
    ? `${origin}/`
    : `${origin}${canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`}`;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://generateurdecouleur.com/og-banner.jpg"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content="https://generateurdecouleur.com/og-banner.jpg"
    />

    <!-- Analytics -->
    <script
      defer
      src="https://api.pirsch.io/pa.js"
      id="pianjs"
      data-code="5C3k55SkoTTy4LonZYJmHMwugsasSt8Z"></script>
  </head>
  <body>
    <slot />
    <AdBanner
      description="Publiez votre site web en quelques minutes avec Framer."
      link="/go/framer"
      imageUrl={framerBanner}
    />
  </body>
</html>
