---
import { hexToHsl, hexToRgb, paletteFromColor } from '../utils/color';

interface Props {
  currentColor: string;
}

const { currentColor } = Astro.props;
const currentRgb = hexToRgb(currentColor);
const currentHsl = hexToHsl(currentColor);
const invitePalette = paletteFromColor(currentColor);
const inviteHref = `/outils/palette-couleurs?c=${currentColor.replace('#', '')}`;
---

<div class="max-w-sm w-full flex flex-col gap-3">
<div class="w-full bg-slate-100 text-slate-900 font-sans p-6 rounded-lg border border-slate-100/20 shadow-lg flex flex-col gap-8">
    <div>
      <h1 class="text-2xl font-bold mb-4">Générateur de couleur aléatoire</h1>
      <p class="text-base font-regular">Générez une couleur au hasard en un clic et copiez son code HEX, RGB ou HSL.</p>
    </div>
    <div class="flex flex-col gap-3 bg-white/70 rounded-lg p-4 border border-slate-200">
        <span class="text-xs font-medium text-zinc-500 uppercase tracking-wide">Codes couleur</span>
        <div class="flex flex-col gap-2.5">
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-zinc-500 w-8 shrink-0">HEX</span>
                <span id="colorCode" class="text-sm font-mono flex-1 min-w-0 truncate">{currentColor}</span>
                <button
                    data-copy-target="colorCode"
                    class="copy-btn relative shrink-0 border border-slate-300 rounded-md text-slate-900 p-1 hover:bg-slate-200 group"
                    aria-label="Copier le code HEX"
                >
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs text-slate-100 bg-slate-900 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
                        Copier
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg>
                </button>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-zinc-500 w-8 shrink-0">RGB</span>
                <span id="colorCodeRgb" class="text-sm font-mono flex-1 min-w-0 truncate">{currentRgb}</span>
                <button
                    data-copy-target="colorCodeRgb"
                    class="copy-btn relative shrink-0 border border-slate-300 rounded-md text-slate-900 p-1 hover:bg-slate-200 group"
                    aria-label="Copier le code RGB"
                >
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs text-slate-100 bg-slate-900 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
                        Copier
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg>
                </button>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-zinc-500 w-8 shrink-0">HSL</span>
                <span id="colorCodeHsl" class="text-sm font-mono flex-1 min-w-0 truncate">{currentHsl}</span>
                <button
                    data-copy-target="colorCodeHsl"
                    class="copy-btn relative shrink-0 border border-slate-300 rounded-md text-slate-900 p-1 hover:bg-slate-200 group"
                    aria-label="Copier le code HSL"
                >
                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 text-xs text-slate-100 bg-slate-900 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
                        Copier
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216,32H88a8,8,0,0,0-8,8V80H40a8,8,0,0,0-8,8V216a8,8,0,0,0,8,8H168a8,8,0,0,0,8-8V176h40a8,8,0,0,0,8-8V40A8,8,0,0,0,216,32ZM160,208H48V96H160Zm48-48H176V88a8,8,0,0,0-8-8H96V48H208Z"></path></svg>
                </button>
            </div>
        </div>
    </div>
    <div class="flex flex-col gap-1">
        <button 
            id="generateColor"
            class="bg-slate-900 text-slate-100 font-semibold text-sm rounded py-3 px-2 hover:bg-opacity-90 transition-colors"
        >
          Générer une autre couleur
        </button>
        <small class="hidden md:block text-slate-500 italic">Astuce : Appuyez sur Espace pour générer une nouvelle couleur au hasard.</small>
    </div>
</div>

<a
  id="paletteInvite"
  href={inviteHref}
  class="flex items-center gap-3 w-full px-3 py-2.5 rounded-lg bg-white/90 backdrop-blur-md border border-white/60 shadow-[0_8px_32px_rgba(15,23,42,0.12)] ring-1 ring-slate-900/5 hover:bg-white transition-colors"
>
  <span class="flex h-8 w-[5.75rem] rounded-md overflow-hidden shrink-0 ring-1 ring-black/10" aria-hidden="true">
    {invitePalette.map((hex) => (
      <span class="palette-invite-swatch flex-1" style={`background-color: ${hex}`}></span>
    ))}
  </span>
  <span class="flex-1 min-w-0 text-sm font-medium text-slate-900 leading-snug">
    Créer une palette avec cette couleur
  </span>
  <svg class="shrink-0 text-slate-400" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true">
    <path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path>
  </svg>
</a>
</div>

<div 
    id="toast" 
    class="fixed bottom-4 md:bottom-24 left-1/2 -translate-x-1/2 bg-slate-900 text-slate-100 border border-slate-100/50 px-4 py-2 rounded-lg opacity-0 transition-opacity duration-300 pointer-events-none"
>
    Code copié !
</div>

<script>
  import { hexToHsl, hexToRgb, paletteFromColor } from '../utils/color';

  function generateRandomColor() {
    const letters = '0123456789ABCDEF';
    let color = '#';
    for (let i = 0; i < 6; i++) {
      color += letters[Math.floor(Math.random() * 16)];
    }
    return color;
  }

  function updatePaletteInvite(hex: string) {
    const invite = document.getElementById('paletteInvite') as HTMLAnchorElement | null;
    const swatches = document.querySelectorAll<HTMLElement>('.palette-invite-swatch');
    const palette = paletteFromColor(hex);
    if (invite) invite.href = `/outils/palette-couleurs?c=${hex.replace('#', '')}`;
    swatches.forEach((swatch, index) => {
      swatch.style.backgroundColor = palette[index] ?? hex;
    });
  }

  function updateColorCodes(hex: string) {
    const colorCode = document.getElementById('colorCode');
    const colorCodeRgb = document.getElementById('colorCodeRgb');
    const colorCodeHsl = document.getElementById('colorCodeHsl');
    if (colorCode) colorCode.textContent = hex;
    if (colorCodeRgb) colorCodeRgb.textContent = hexToRgb(hex);
    if (colorCodeHsl) colorCodeHsl.textContent = hexToHsl(hex);
    updatePaletteInvite(hex);
  }

  function updateColor() {
    const newColor = generateRandomColor();
    document.getElementById('colorSection')!.style.backgroundColor = newColor;
    updateColorCodes(newColor);
  }

  function showToast() {
    const toast = document.getElementById('toast');
    if (toast) {
      toast.classList.remove('opacity-0');
      setTimeout(() => {
        toast.classList.add('opacity-0');
      }, 2000);
    }
  }

  document.getElementById('generateColor')?.addEventListener('click', updateColor);

  document.addEventListener('keydown', (event) => {
    if (event.code === 'Space' && !event.repeat && !(event.target as Element).matches('input, textarea')) {
      event.preventDefault();
      updateColor();
    }
  });

  document.querySelectorAll('.copy-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const targetId = button.getAttribute('data-copy-target');
      const text = targetId ? document.getElementById(targetId)?.textContent : null;
      if (text) {
        await navigator.clipboard.writeText(text);
        showToast();
      }
    });
  });
</script>
