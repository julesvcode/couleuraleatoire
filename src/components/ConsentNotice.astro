<aside
  id="consent-notice"
  class="fixed bottom-6 right-6 z-50 w-[min(20rem,calc(100vw-3rem))] rounded-lg border border-zinc-200 bg-zinc-50 p-3.5 font-sans shadow-lg shadow-zinc-400"
  aria-label="Cookies"
>
  <p class="text-lg font-semibold text-zinc-700">Ce site utilise des cookies</p>
  <p class="mt-2 text-sm leading-6 text-zinc-700">
    Nous utilisons des cookies pour mesurer l'audience et améliorer votre expérience. Vous pouvez les accepter ou les refuser.
  </p>
  <div class="mt-3 flex gap-2">
    <button
      id="consent-deny"
      type="button"
      class="flex-1 rounded-md border border-zinc-300 bg-white p-2 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100"
    >
      Refuser
    </button>
    <button
      id="consent-accept"
      type="button"
      class="flex-1 rounded-md border border-white bg-gradient-to-b from-zinc-700 to-zinc-950 p-2 text-sm font-medium text-zinc-50"
    >
      Accepter
    </button>
  </div>
</aside>

<script is:inline>
  (function () {
    var measurementId = 'G-9EVBQ2CK1T';

    function readChoice() {
      try {
        return localStorage.getItem('analyticsConsent');
      } catch (error) {
        return null;
      }
    }

    function loadGoogleAnalytics() {
      if (document.getElementById('ga-gtag')) return;

      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', measurementId);

      var script = document.createElement('script');
      script.id = 'ga-gtag';
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
      document.head.appendChild(script);
    }

    function choose(choice) {
      try {
        localStorage.setItem('analyticsConsent', choice);
      } catch (error) {}
      document.documentElement.classList.add('consent-known');
      if (choice === 'granted') loadGoogleAnalytics();
    }

    if (readChoice() === 'granted') loadGoogleAnalytics();

    var deny = document.getElementById('consent-deny');
    var accept = document.getElementById('consent-accept');
    if (!deny || !accept) return;

    deny.addEventListener('click', function () {
      choose('denied');
    });
    accept.addEventListener('click', function () {
      choose('granted');
    });
  })();
</script>
