---
import Layout from '../../layouts/Layout.astro';
import ColorPageHero from '../../components/ColorPageHero.astro';
import ToolNav from '../../components/ToolNav.astro';
import Footer from '../../components/Footer.astro';
import {
  ALL_COLOR_PAGES,
  capitalize,
  colorBySlug,
  colorHref,
  familyOf,
  isFamily,
  listNames,
  ofColor,
  shadesOf,
  type ColorPage,
} from '../../data/couleurs';
import {
  complementaryHex,
  contrastingTextColor,
  hexToCmyk,
  hexToHslChannels,
  hexToRgb,
  mixHex,
  nearestColor,
} from '../../utils/color';

export function getStaticPaths() {
  return ALL_COLOR_PAGES.map((color) => ({ params: { slug: color.slug } }));
}

const color = colorBySlug(Astro.params.slug as string);
const family = familyOf(color);
const onFamilyPage = isFamily(color);
const shades = shadesOf(family.slug);
const pairs = color.pairsWith.map(colorBySlug);
const drawPool: ColorPage[] = [family, ...shades].filter((item) => item.slug !== color.slug);

const title = onFamilyPage ? `Couleur ${family.adjective}` : color.name;
const of = ofColor(color.withArticle);
const pageTitle = onFamilyPage
  ? `Couleur ${family.adjective} : codes HEX, nuances et palettes`
  : `${color.name} : code couleur HEX, RGB et CMYK`;
const description = onFamilyPage
  ? `Code couleur ${of} (${color.hex}), ${shades.length > 0 ? `${shades.length} nuances de ${family.name.toLowerCase()} à copier, ` : ''}couleurs qui vont avec et palette prête à l'emploi.`
  : `Code couleur ${of} : HEX ${color.hex}, ${hexToRgb(color.hex)}, CMYK ${hexToCmyk(color.hex)}. Nuances proches, couleurs qui vont avec et palette à copier.`;

const drawLabel = `Tirer une nuance de ${family.name.toLowerCase()} au hasard`;
const complement = complementaryHex(color.hex);
const showComplement = (hexToHslChannels(color.hex)?.s ?? 0) >= 10;
const nearestToComplement = nearestColor(complement, ALL_COLOR_PAGES);
const complementName = nearestToComplement?.slug === color.slug ? null : nearestToComplement;
const variations = [
  ...[0.8, 0.6, 0.4, 0.2].map((amount) => ({ hex: mixHex(color.hex, '#FFFFFF', amount), label: 'Plus clair' })),
  { hex: color.hex, label: color.name },
  ...[0.2, 0.4, 0.6, 0.8].map((amount) => ({ hex: mixHex(color.hex, '#000000', amount), label: 'Plus foncé' })),
].filter((item, index, list) => list.findIndex((other) => other.hex === item.hex) === index);
const paletteHref = `/outils/palette-couleurs?c=${color.hex.replace('#', '')}`;

const faqs = [
  {
    question: `Quel est le code couleur ${of} ?`,
    answer: `Le code HEX ${of} est ${color.hex}. En RGB : ${hexToRgb(color.hex)}. En CMYK : ${hexToCmyk(color.hex)}.`,
  },
  ...(onFamilyPage && shades.length > 0
    ? [{
        question: `Quelles sont les nuances de ${family.name.toLowerCase()} ?`,
        answer: `Parmi les nuances de ${family.name.toLowerCase()} les plus recherchées : ${listNames(shades)}.`,
      }]
    : []),
  {
    question: `Quelles couleurs vont avec ${color.withArticle} ?`,
    answer: `${capitalize(color.withArticle)} s'accorde bien avec ${listNames(pairs)}. Vous pouvez aussi générer une palette complète à partir ${of} avec le générateur de palette.`,
  },
  ...(showComplement
    ? [{
        question: `Quelle est la couleur complémentaire ${of} ?`,
        answer: `La couleur complémentaire ${of} est ${complement}, à l'opposé sur le cercle chromatique${complementName ? `, proche ${ofColor(complementName.withArticle)}` : ''}.`,
      }]
    : []),
  ...(onFamilyPage
    ? []
    : [{
        question: `Existe-t-il un seul code pour ${color.withArticle} ?`,
        answer: `Non. Les noms de couleur ne sont pas normalisés : selon les nuanciers et les marques de peinture, ${color.withArticle} peut varier légèrement. ${color.hex} est une valeur de référence courante.`,
      }]),
];
---

<Layout
  title={pageTitle}
  description={description}
  canonicalPath={colorHref(color)}
  markdownPath={`${colorHref(color)}.md`}
  faqs={faqs}
>
  <main>
    <ColorPageHero color={color} title={title} drawLabel={drawLabel} drawPool={drawPool} />
    <ToolNav />
    <section class="max-w-xl flex flex-col gap-8 my-0 mx-auto py-12 px-4 font-sans">
      <nav aria-label="Fil d'Ariane" class="text-sm text-slate-500">
        <a href="/couleurs" class="hover:text-slate-900 underline">Couleurs</a>
        {!onFamilyPage && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={colorHref(family)} class="hover:text-slate-900 underline">{family.name}</a>
          </>
        )}
        <span aria-hidden="true"> / </span>
        <span class="text-slate-900">{color.name}</span>
      </nav>
      <div>
        <h2 class="text-slate-900 font-semibold text-2xl mb-4">
          {onFamilyPage ? `La couleur ${family.adjective}` : `${color.name}, en quelques mots`}
        </h2>
        <p class="text-slate-600 font-normal text-base leading-normal">
          {color.description}
        </p>
      </div>
      {shades.length > 0 && (
        <div>
          <h2 class="text-slate-900 font-semibold text-2xl mb-4">
            {onFamilyPage ? `Nuances de ${family.name.toLowerCase()}` : `Autres nuances de ${family.name.toLowerCase()}`}
          </h2>
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {[family, ...shades].map((item) => (
              <li>
                <a
                  href={colorHref(item)}
                  aria-current={item.slug === color.slug ? 'page' : undefined}
                  class:list={[
                    'flex flex-col rounded-lg border overflow-hidden transition-shadow hover:shadow-md',
                    item.slug === color.slug ? 'border-slate-900 ring-1 ring-slate-900' : 'border-slate-200',
                  ]}
                >
                  <span class="h-14" style={`background-color: ${item.hex}`}></span>
                  <span class="px-3 py-2">
                    <span class="block text-sm font-medium text-slate-900">{item.name}</span>
                    <span class="block text-xs font-mono text-slate-500">{item.hex}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <h2 class="text-slate-900 font-semibold text-2xl mb-4">
          Quelles couleurs vont avec {color.withArticle} ?
        </h2>
        <p class="text-slate-600 font-normal text-base leading-normal mb-4">
          {capitalize(color.withArticle)} s'accorde bien avec {listNames(pairs)}.
        </p>
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
          {pairs.map((item) => (
            <li>
              <a href={colorHref(item)} class="flex flex-col rounded-lg border border-slate-200 overflow-hidden transition-shadow hover:shadow-md">
                <span class="flex h-14">
                  <span class="flex-1" style={`background-color: ${color.hex}`}></span>
                  <span class="flex-1" style={`background-color: ${item.hex}`}></span>
                </span>
                <span class="px-3 py-2">
                  <span class="block text-sm font-medium text-slate-900">{item.name}</span>
                  <span class="block text-xs font-mono text-slate-500">{item.hex}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="text-slate-600 font-normal text-base leading-normal">
          Besoin de plus de couleurs ?
          <a href={paletteHref} class="text-slate-900 font-medium underline hover:text-slate-700">Créer une palette à partir {of}</a>.
        </p>
      </div>
      <div>
        <h2 class="text-slate-900 font-semibold text-2xl mb-4">
          {capitalize(color.withArticle)} plus clair ou plus foncé
        </h2>
        <p class="text-slate-600 font-normal text-base leading-normal mb-4">
          Cliquez sur une teinte pour copier son code HEX.
        </p>
        <div class="flex rounded-lg overflow-hidden border border-slate-200">
          {variations.map((item) => (
            <button
              data-copy={item.hex}
              title={`${item.label} · ${item.hex}`}
              aria-label={`Copier ${item.hex}`}
              class="group flex-1 h-20 flex items-end justify-center pb-2"
              style={`background-color: ${item.hex}; color: ${contrastingTextColor(item.hex)}`}
            >
              <span class="hidden sm:inline text-[10px] font-mono opacity-0 group-hover:opacity-100 transition-opacity">
                {item.hex}
              </span>
            </button>
          ))}
        </div>
      </div>
      {showComplement && (
      <div>
        <h2 class="text-slate-900 font-semibold text-2xl mb-4">
          Couleur complémentaire {of}
        </h2>
        <div class="flex items-center gap-4">
          <button
            data-copy={complement}
            aria-label={`Copier ${complement}`}
            class="h-16 w-16 shrink-0 rounded-lg border border-slate-200"
            style={`background-color: ${complement}`}
          ></button>
          <p class="text-slate-600 font-normal text-base leading-normal">
            La couleur opposée {of} sur le cercle chromatique est <span class="font-mono text-slate-900">{complement}</span>{complementName && (
              <>, proche <a href={colorHref(complementName)} class="text-slate-900 font-medium underline hover:text-slate-700">{ofColor(complementName.withArticle)}</a></>
            )}. Associées, les deux couleurs créent un contraste fort.
          </p>
        </div>
      </div>
      )}
      <div>
        <h2 class="text-slate-900 font-semibold text-2xl mb-4">
          Questions fréquentes
        </h2>
        {faqs.map((faq) => (
          <>
            <h3 class="text-slate-900 font-semibold text-base leading-normal mb-1">{faq.question}</h3>
            <p class="text-slate-600 text-base leading-normal font-normal mb-4">{faq.answer}</p>
          </>
        ))}
      </div>
      <div>
        <p class="text-slate-600 font-normal text-base leading-normal">
          Vous avez un code dans un autre format ? Utilisez le
          <a href="/outils/convertisseur-couleur" class="text-slate-900 font-medium underline hover:text-slate-700">convertisseur de couleur</a>,
          ou découvrez <a href="/couleurs" class="text-slate-900 font-medium underline hover:text-slate-700">toutes les couleurs</a>.
        </p>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
