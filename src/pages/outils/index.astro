---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ToolNav from '../../components/ToolNav.astro';
import { TOOLS } from '../../data/tools';
---

<Layout
  title="Outils de couleur gratuits | Générateur de couleur"
  description="Tous les outils de couleur : générateur aléatoire, palette, convertisseur, couleur au hasard et tirage au sort. Simples, rapides et gratuits, sans inscription."
  canonicalPath="/outils/"
  markdownPath="/outils/index.md"
>
  <main>
    <ToolNav />
    <section class="max-w-xl flex flex-col gap-8 my-0 mx-auto pt-28 pb-12 px-4 font-sans">
      <div>
        <h1 class="text-4xl text-slate-900 font-bold leading-normal mb-4">
          Outils de couleur
        </h1>
        <p class="text-slate-600 text-base leading-normal">
          Des outils simples, rapides et gratuits pour générer, convertir, choisir ou tirer une couleur au sort.
        </p>
      </div>
      <ul class="flex flex-col gap-3">
        {TOOLS.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="block rounded-lg border border-slate-200 bg-slate-50 px-4 py-4 hover:border-slate-300 hover:bg-white transition-colors"
            >
              <span class="block text-slate-900 font-semibold">{tool.label}</span>
              <span class="block mt-1 text-sm font-normal text-slate-600 leading-normal">
                {tool.description}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <Footer />
  </main>
</Layout>
